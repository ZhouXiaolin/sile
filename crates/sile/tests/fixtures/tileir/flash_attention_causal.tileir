      %390 = addi %386, %389 : tile<i32>
      %391 = cmpi less_than %86, %390, signed : tile<i32> -> tile<i1>
      %392 = constant <i32: 0> : tile<i32>
      %393 = cmpi greater_than_or_equal %86, %392, signed : tile<i32> -> tile<i1>
      %394 = andi %393, %391 : tile<i1>
      assert %394, "partition access out of bounds: dim 1, block index >= ceil(?/1) or index < 0" : tile<i1>
      %395 = constant <i32: 32> : tile<i32>
      %396 = divi %68, %395 signed : tile<i32>
      %397 = remi %68, %395 signed : tile<i32>
      %398 = constant <i32: 1> : tile<i32>
      %399 = mini %397, %398 signed : tile<i32>
      %400 = addi %396, %399 : tile<i32>
      %401 = cmpi less_than %253, %400, signed : tile<i32> -> tile<i1>
      %402 = constant <i32: 0> : tile<i32>
      %403 = cmpi greater_than_or_equal %253, %402, signed : tile<i32> -> tile<i1>
      %404 = andi %403, %401 : tile<i1>
      assert %404, "partition access out of bounds: dim 2, block index >= ceil(?/32) or index < 0" : tile<i1>
      %405, %406 = load_view_tko weak %197[%84, %86, %253, %370] token = %70 : partition_view<tile=(1x1x32x32), padding_value = zero, tensor_view<?x?x?x?xf32, strides=[16384,2048,32,1]>>, tile<i32> -> tile<1x1x32x32xf32>, token
      %407 = constant <i32: 1> : tile<i32>
      %408 = constant <i32: 1> : tile<i32>
      %409 = constant <i32: 32> : tile<i32>
      %410 = constant <i32: 32> : tile<i32>
      %411 = constant <i32: 32> : tile<i32>
      %412 = constant <i32: 32> : tile<i32>
      %413 = reshape %405 : tile<1x1x32x32xf32> -> tile<32x32xf32>
      %414 = mmaf %351, %413, %369 : tile<32x32xf32>, tile<32x32xf32>, tile<32x32xf32>
      continue %414, %363, %344 : tile<32x32xf32>, tile<32x1xf32>, tile<32x1xf32>
    }
    %418 = constant <i32: 32> : tile<i32>
    %419 = constant <i32: 1> : tile<i32>
    %420 = constant <i32: 32> : tile<i32>
    %421 = constant <i32: 32> : tile<i32>
    %422 = broadcast %416 : tile<32x1xf32> -> tile<32x32xf32>
    %423 = divf %415, %422 rounding<approx> flush_to_zero : tile<32x32xf32>
    %424 = constant <i32: 32> : tile<i32>
    %425 = constant <i32: 32> : tile<i32>
    %426 = constant <i32: 1> : tile<i32>
    %427 = constant <i32: 32> : tile<i32>
    %428 = constant <i32: 32> : tile<i32>
    %429 = reshape %423 : tile<32x32xf32> -> tile<1x32x32xf32>
    %430 = constant <i32: 1> : tile<i32>
    %431 = constant <i32: 32> : tile<i32>
    %432 = constant <i32: 32> : tile<i32>
    %433 = constant <i32: 1> : tile<i32>
    %434 = constant <i32: 32> : tile<i32>
    %435 = constant <i32: 32> : tile<i32>
    %436, %437, %438 = get_tile_block_id : tile<i32>
    %439 = assume bounded<0, ?>, %436 : tile<i32>
    %440 = assume bounded<0, ?>, %437 : tile<i32>
    %441 = assume bounded<0, ?>, %438 : tile<i32>
    %442 = constant <i32: 1> : tile<i32>
    %443 = constant <i32: 32> : tile<i32>
    %444 = constant <i32: 32> : tile<i32>
    %445 = make_partition_view %53 : partition_view<tile=(1x32x32), tensor_view<?x?x?xf32, strides=[2048,32,1]>>
    %446 = store_view_tko weak %429, %445[%439, %440, %441] token = %52 : tile<1x32x32xf32>, partition_view<tile=(1x32x32), tensor_view<?x?x?xf32, strides=[2048,32,1]>>, tile<i32> -> token
    return
  }
}
