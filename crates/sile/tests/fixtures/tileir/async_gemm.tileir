cuda_tile.module @kernels {
  entry @gemm_entry(%0: tile<ptr<f32>>, %1: tile<i32>, %2: tile<i32>, %3: tile<i32>, %4: tile<i32>, %5: tile<i32>, %6: tile<i32>, %7: tile<i32>, %8: tile<i32>, %9: tile<ptr<f16>>, %10: tile<i32>, %11: tile<i32>, %12: tile<i32>, %13: tile<i32>, %14: tile<ptr<f16>>, %15: tile<i32>, %16: tile<i32>, %17: tile<i32>, %18: tile<i32>) di_name = "gemm" {
    %19 = constant <i32: 16> : tile<i32>
    %20 = constant <i32: 16> : tile<i32>
    %21 = constant <i32: 8> : tile<i32>
    %22 = constant <i32: 16> : tile<i32>
    %23 = assume bounded<0, ?>, %1 : tile<i32>
    %24 = assume bounded<0, ?>, %2 : tile<i32>
    %25 = make_token : token
    %26 = make_tensor_view %0, shape = [%23, %24], strides = [64, 1] : tile<i32> -> tensor_view<?x?xf32, strides=[64,1]>
    %27 = assume bounded<0, ?>, %10 : tile<i32>
    %28 = make_token : token
    %29 = make_tensor_view %9, shape = [%27, 16], strides = [16, 1] : tile<i32> -> tensor_view<?x16xf16, strides=[16,1]>
    %30 = assume bounded<0, ?>, %16 : tile<i32>
    %31 = make_token : token
    %32 = make_tensor_view %14, shape = [16, %30], strides = [64, 1] : tile<i32> -> tensor_view<16x?xf16, strides=[64,1]>
    %33 = constant <i32: 16> : tile<i32>
    %34 = constant <i32: 16> : tile<i32>
    %35 = constant <i32: 8> : tile<i32>
    %36 = constant <i32: 16> : tile<i32>
    %37 = constant <i32: 16> : tile<i32>
    %38 = constant <i32: 8> : tile<i32>
    %39 = constant <i32: -1> : tile<i32>
    %40 = constant <i32: 16> : tile<i32>
    %41 = constant <i32: -1> : tile<i32>
    %42 = constant <i32: 16> : tile<i32>
    %43 = make_partition_view %29 : partition_view<tile=(16x8), padding_value = zero, tensor_view<?x16xf16, strides=[16,1]>>
    %44 = constant <i32: 8> : tile<i32>
    %45 = constant <i32: 16> : tile<i32>
    %46 = constant <i32: 16> : tile<i32>
    %47 = constant <i32: -1> : tile<i32>
    %48 = constant <i32: 16> : tile<i32>
    %49 = constant <i32: -1> : tile<i32>
    %50 = make_partition_view %32 : partition_view<tile=(8x16), padding_value = zero, tensor_view<16x?xf16, strides=[64,1]>>
    %51, %52, %53 = get_tile_block_id : tile<i32>
    %54 = assume bounded<0, ?>, %51 : tile<i32>
    %55 = assume bounded<0, ?>, %52 : tile<i32>
    %56 = assume bounded<0, ?>, %53 : tile<i32>
    %57 = constant <i32: 16> : tile<i32>
    %58 = constant <i32: 16> : tile<i32>
    %59 = constant <i32: 16> : tile<i32>
    %60 = constant <i32: 16> : tile<i32>
    %61, %62, %63 = get_tile_block_id : tile<i32>
    %64 = assume bounded<0, ?>, %61 : tile<i32>
    %65 = assume bounded<0, ?>, %62 : tile<i32>
    %66 = assume bounded<0, ?>, %63 : tile<i32>
    %67 = constant <i32: 16> : tile<i32>
    %68 = constant <i32: 16> : tile<i32>
    %69 = make_partition_view %26 : partition_view<tile=(16x16), tensor_view<?x?xf32, strides=[64,1]>>
    %70, %71 = load_view_tko weak %69[%64, %65] token = %25 : partition_view<tile=(16x16), tensor_view<?x?xf32, strides=[64,1]>>, tile<i32> -> tile<16x16xf32>, token
    %72 = constant <i32: 0> : tile<i32>
    %74 = constant <i32: 2> : tile<i32>
    %75 = constant <i32: 1> : tile<i32>
    %88 = for %76 in (%72 to %74, step %75) : tile<i32> iter_values(%77 = %70) -> (tile<16x16xf32>) {
      %78 = assume bounded<0, 1>, %76 : tile<i32>
      %79 = constant <i32: 16> : tile<i32>
      %80 = constant <i32: 8> : tile<i32>
      %81, %82 = load_view_tko weak %43[%54, %78] token = %28 : partition_view<tile=(16x8), padding_value = zero, tensor_view<?x16xf16, strides=[16,1]>>, tile<i32> -> tile<16x8xf16>, token
      %83 = constant <i32: 8> : tile<i32>
      %84 = constant <i32: 16> : tile<i32>
      %85, %86 = load_view_tko weak %50[%78, %55] token = %31 : partition_view<tile=(8x16), padding_value = zero, tensor_view<16x?xf16, strides=[64,1]>>, tile<i32> -> tile<8x16xf16>, token
      %87 = mmaf %81, %85, %77 : tile<16x8xf16>, tile<8x16xf16>, tile<16x16xf32>
      continue %87 : tile<16x16xf32>
    }
    %89 = constant <i32: 16> : tile<i32>
    %90 = constant <i32: 16> : tile<i32>
    %91 = constant <i32: 16> : tile<i32>
    %92 = constant <i32: 16> : tile<i32>
    %93, %94, %95 = get_tile_block_id : tile<i32>
    %96 = assume bounded<0, ?>, %93 : tile<i32>
    %97 = assume bounded<0, ?>, %94 : tile<i32>
    %98 = assume bounded<0, ?>, %95 : tile<i32>
    %99 = constant <i32: 16> : tile<i32>
    %100 = constant <i32: 16> : tile<i32>
    %101 = make_partition_view %26 : partition_view<tile=(16x16), tensor_view<?x?xf32, strides=[64,1]>>
    %102 = store_view_tko weak %88, %101[%96, %97] token = %25 : tile<16x16xf32>, partition_view<tile=(16x16), tensor_view<?x?xf32, strides=[64,1]>>, tile<i32> -> token
    return
  }
}
